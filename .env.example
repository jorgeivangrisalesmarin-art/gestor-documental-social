# ==============================================================================
# CONFIGURACIÓN DEL GESTOR DOCUMENTAL SOCIAL
# Copia este archivo como .env y ajusta los valores correspondientes.
# NUNCA subas archivos .env a Git.
# ==============================================================================

# Entorno general
ENVIRONMENT=development
LOG_LEVEL=INFO

# Proveedores de consulta (ADRES, SISBÉN IV, RUI)
PLACAPI_API_KEY=pk_live_pon_tu_clave_aqui
ARBOL_API_KEY=pon_tu_token_bearer_aqui

# Seguridad y Criptografía (Ley 1581 de 2012)
DOC_HMAC_KEY=clave_secreta_para_hashear_cedulas_minimo_32_caracteres
SESSION_SECRET_KEY=clave_para_firmar_cookies_de_sesion

# Base de datos y Caché
DATABASE_URL=sqlite:///./dev.db
REDIS_URL=redis://localhost:6379/0

# Almacenamiento de documentos (Cloud Storage / Local)
STORAGE_BUCKET_NAME=gds-documents-bucket
STORAGE_LOCAL_PATH=./storage/documents
