# Gestor Documental Social — variables de entorno (ejemplo; NUNCA subir valores reales)

# --- API ---
APP_ENV=development
API_PORT=8000
WEB_ORIGIN=http://localhost:3000
JWT_SECRET=cambia-esto-en-produccion
SEED_ADMIN_EMAIL=admin@local.test
SEED_ADMIN_PASSWORD=cambia-esto
DATABASE_URL=postgresql+asyncpg://gds:gds@postgres:5432/gds
# Para dev rápido sin Postgres: sqlite+aiosqlite:///./gds.db

# Cifrado de identificaciones y huella de búsqueda (generar con:
#   python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
#   python -c "import secrets; print(secrets.token_hex(32))"
DOC_ENCRYPTION_KEY=
DOC_HMAC_KEY=

# --- Proveedores (sin valor => adaptadores fixture etiquetados como ficticios) ---
PLACAPI_API_KEY=
# ARBOL_API_KEY=

# --- Documentos ---
DOCUMENT_STORAGE_PATH=./data/documents

# --- Proveedores en scripts de sondeo (T001) ---
PROBE_API_KEY=
PROBE_REAL_DOC=
